{
  "name": "brogatchi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "brotasy:validate": "tsx scripts/brotasy-pipeline/validate-world-data.ts",
    "brotasy:simulate": "tsx scripts/brotasy-pipeline/simulate-combat-balance.ts",
    "brotasy:bible": "tsx scripts/brotasy-pipeline/generate-world-bible.ts",
    "brotasy:pipeline": "tsx scripts/brotasy-pipeline/validate-world-data.ts && tsx scripts/brotasy-pipeline/simulate-combat-balance.ts && tsx scripts/brotasy-pipeline/generate-world-bible.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.21",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
