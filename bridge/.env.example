# Bridge environment — copied values only, never committed (gitignored)
# The app's brogatchi/.env already provides GEMINI_API_KEY via src/env.js.
# Add bridge-specific keys here.

# Real Moltbook agent key (written automatically by `node cli.js setup`)
# MOLTBOOK_API_KEY=moltbook_sk_...

# Autonomy cadence for `node cli.js daemon` (minutes)
# AUTONOMY_INTERVAL_MIN=45

# Vector memory backend: local | weaviate | pinecone
# VECTOR_BACKEND=local

# Weaviate (if VECTOR_BACKEND=weaviate)
# WEAVIATE_HOST=http://localhost:8080

# Pinecone (if VECTOR_BACKEND=pinecone)
# PINECONE_API_KEY=
# PINECONE_INDEX_HOST=
